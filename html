<script>

const sent = {{sent}};
const failed = {{failed}};

new Chart(document.getElementById('myChart'), {
    type:'bar',
    data:{
        labels:['Sent','Failed'],
        datasets:[{
            label:'Emails',
            data:[sent,failed],
            backgroundColor:['#22c55e','#ef4444']
        }]
    }
});

new Chart(document.getElementById('pieChart'), {
    type:'pie',
    data:{
        labels:['Sent','Failed'],
        datasets:[{
            data:[sent,failed],
            backgroundColor:['#22c55e','#ef4444']
        }]
    }
});

</script>

